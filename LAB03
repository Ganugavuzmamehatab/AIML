import csv

# Dataset
dataset = [
    ["High", "Large", "High", "Dedicated", "Yes", "Yes"],
    ["High", "Small", "High", "Shared", "Yes", "No"],
    ["High", "Large", "High", "Shared", "Yes", "Yes"],
    ["Low", "Large", "Medium", "Shared", "No", "No"],
    ["High", "Large", "High", "Dedicated", "No", "Yes"]
]

# Save dataset as CSV
with open("workload_data.csv", "w", newline="") as file:
    writer = csv.writer(file)
    writer.writerow([
        "Latency Sensitivity",
        "Data Volume",
        "RAM Demand",
        "Network Bandwidth",
        "GPU Required",
        "High-Performance Edge"
    ])
    writer.writerows(dataset)

# Read dataset from CSV
data = []
with open("workload_data.csv", "r") as file:
    reader = csv.reader(file)
    header = next(reader)
    for row in reader:
        data.append(row)

print("===== DATASET =====")
print(header)
for row in data:
    print(row)

# Initialize hypothesis
hypothesis = ['0'] * (len(header) - 1)

print("\nInitial Hypothesis:")
print(hypothesis)

# Find-S Algorithm
for i, row in enumerate(data):
    if row[-1] == "Yes":
        for j in range(len(hypothesis)):
            if hypothesis[j] == '0':
                hypothesis[j] = row[j]
            elif hypothesis[j] != row[j]:
                hypothesis[j] = '?'

    print(f"\nHypothesis after processing Row {i+1}:")
    print(hypothesis)

print("\n===== FINAL SPECIFIC HYPOTHESIS =====")
print(hypothesis)
